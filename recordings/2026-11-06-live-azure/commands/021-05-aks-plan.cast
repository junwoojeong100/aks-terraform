[4.618156, "o", "  + resource \"azurerm_monitor_alert_prometheus_rule_group\" \"kubernetes_recording_rules\" {\r\n"]
[4.618183, "o", "      + cluster_name        = \"aks-ep03live-test-krc\"\r\n"]
[4.61821, "o", "      + description         = \"Kubernetes Recording Rules Rule Group\"\r\n"]
[4.618238, "o", "      + id                  = (known after apply)\r\n"]
[4.618266, "o", "      + interval            = \"PT1M\"\r\n"]
[4.618293, "o", "      + location            = \"koreacentral\"\r\n"]
[4.618327, "o", "      + name                = \"KubernetesRecordingRulesRuleGroup-aks-ep03live-test-krc\"\r\n"]
[4.618355, "o", "      + resource_group_name = \"rg-ep03live-test-krc-aks\"\r\n"]
[4.618384, "o", "      + rule_group_enabled  = true\r\n"]
[4.618412, "o", "      + scopes              = (known after apply)\r\n"]
[4.618438, "o", "      + tags                = {\r\n"]
[4.618462, "o", "          + \"environment\"  = \"test\"\r\n"]
[4.618489, "o", "          + \"lab\"          = \"aks-terraform-guide\"\r\n"]
[4.618514, "o", "          + \"managed_by\"   = \"terraform\"\r\n"]
[4.61854, "o", "          + \"purpose\"      = \"temporary-recorded-lab\"\r\n"]
[4.618565, "o", "          + \"recording_id\" = \"ep03-20261106T030601Z\"\r\n"]
[4.618593, "o", "          + \"workload\"     = \"ep03live\"\r\n"]
[4.618626, "o", "        }\r\n"]
[4.618651, "o", "\r\n"]
[4.618679, "o", "      + rule {\r\n"]
[4.618708, "o", "          + enabled    = true\r\n"]
[4.618733, "o", "          + expression = <<-EOT\r\n"]
[4.618772, "o", "                sum by (cluster, namespace, pod, container) (  irate(container_cpu_usage_seconds_total{job=\"cadvisor\", image!=\"\"}[5m])) * on (cluster, namespace, pod) group_left(node) topk by (cluster, namespace, pod) (  1, max by(cluster, namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.618811, "o", "            EOT\r\n"]
[4.618842, "o", "          + record     = \"node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate\"\r\n"]
[4.618867, "o", "        }\r\n"]
[4.618896, "o", "      + rule {\r\n"]
[4.618923, "o", "          + enabled    = true\r\n"]
[4.618948, "o", "          + expression = <<-EOT\r\n"]
[4.618982, "o", "                container_memory_working_set_bytes{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.619012, "o", "            EOT\r\n"]
[4.61904, "o", "          + record     = \"node_namespace_pod_container:container_memory_working_set_bytes\"\r\n"]
[4.619067, "o", "        }\r\n"]
[4.619092, "o", "      + rule {\r\n"]
[4.619119, "o", "          + enabled    = true\r\n"]
[4.619144, "o", "          + expression = <<-EOT\r\n"]
[4.619175, "o", "                container_memory_rss{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.619208, "o", "            EOT\r\n"]
[4.619236, "o", "          + record     = \"node_namespace_pod_container:container_memory_rss\"\r\n"]
[4.619262, "o", "        }\r\n"]
[4.619293, "o", "      + rule {\r\n"]
[4.619326, "o", "          + enabled    = true\r\n"]
[4.619356, "o", "          + expression = <<-EOT\r\n"]
[4.619389, "o", "                container_memory_cache{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.619415, "o", "            EOT\r\n"]
[4.619444, "o", "          + record     = \"node_namespace_pod_container:container_memory_cache\"\r\n"]
[4.619469, "o", "        }\r\n"]
[4.619494, "o", "      + rule {\r\n"]
[4.619521, "o", "          + enabled    = true\r\n"]
[4.61955, "o", "          + expression = <<-EOT\r\n"]
[4.619581, "o", "                container_memory_swap{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.619607, "o", "            EOT\r\n"]
[4.619633, "o", "          + record     = \"node_namespace_pod_container:container_memory_swap\"\r\n"]
[4.61966, "o", "        }\r\n"]
[4.619686, "o", "      + rule {\r\n"]
[4.619715, "o", "          + enabled    = true\r\n"]
[4.619746, "o", "          + expression = <<-EOT\r\n"]
[4.61978, "o", "                kube_pod_container_resource_requests{resource=\"memory\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[4.61981, "o", "            EOT\r\n"]
[4.619838, "o", "          + record     = \"cluster:namespace:pod_memory:active:kube_pod_container_resource_requests\"\r\n"]
[4.619864, "o", "        }\r\n"]
[4.619888, "o", "      + rule {\r\n"]
[4.619914, "o", "          + enabled    = true\r\n"]
[4.619938, "o", "          + expression = <<-EOT\r\n"]
[4.619984, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_requests{resource=\"memory\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.620017, "o", "            EOT\r\n"]
[4.620049, "o", "          + record     = \"namespace_memory:kube_pod_container_resource_requests:sum\"\r\n"]
[4.620073, "o", "        }\r\n"]
[4.620102, "o", "      + rule {\r\n"]
[4.620132, "o", "          + enabled    = true\r\n"]
[4.620158, "o", "          + expression = <<-EOT\r\n"]
[4.620191, "o", "                kube_pod_container_resource_requests{resource=\"cpu\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[4.620223, "o", "            EOT\r\n"]
[4.620255, "o", "          + record     = \"cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests\"\r\n"]
[4.620282, "o", "        }\r\n"]
[4.620313, "o", "      + rule {\r\n"]
[4.620338, "o", "          + enabled    = true\r\n"]
[4.620366, "o", "          + expression = <<-EOT\r\n"]
[4.620403, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_requests{resource=\"cpu\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.62043, "o", "            EOT\r\n"]
[4.620462, "o", "          + record     = \"namespace_cpu:kube_pod_container_resource_requests:sum\"\r\n"]
[4.620489, "o", "        }\r\n"]
[4.620517, "o", "      + rule {\r\n"]
[4.620546, "o", "          + enabled    = true\r\n"]
[4.620573, "o", "          + expression = <<-EOT\r\n"]
[4.620612, "o", "                kube_pod_container_resource_limits{resource=\"memory\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[4.620641, "o", "            EOT\r\n"]
[4.620671, "o", "          + record     = \"cluster:namespace:pod_memory:active:kube_pod_container_resource_limits\"\r\n"]
[4.620699, "o", "        }\r\n"]
[4.620726, "o", "      + rule {\r\n"]
[4.620752, "o", "          + enabled    = true\r\n"]
[4.620778, "o", "          + expression = <<-EOT\r\n"]
[4.620817, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_limits{resource=\"memory\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.620845, "o", "            EOT\r\n"]
[4.620872, "o", "          + record     = \"namespace_memory:kube_pod_container_resource_limits:sum\"\r\n"]
[4.620898, "o", "        }\r\n"]
[4.620924, "o", "      + rule {\r\n"]
[4.620953, "o", "          + enabled    = true\r\n"]
[4.620978, "o", "          + expression = <<-EOT\r\n"]
[4.62101, "o", "                kube_pod_container_resource_limits{resource=\"cpu\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) ( (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1) )\r\n"]
[4.621046, "o", "            EOT\r\n"]
[4.621072, "o", "          + record     = \"cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits\"\r\n"]
[4.621102, "o", "        }\r\n"]
[4.621127, "o", "      + rule {\r\n"]
[4.621156, "o", "          + enabled    = true\r\n"]
[4.62118, "o", "          + expression = <<-EOT\r\n"]
[4.621218, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_limits{resource=\"cpu\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.621248, "o", "            EOT\r\n"]
[4.621274, "o", "          + record     = \"namespace_cpu:kube_pod_container_resource_limits:sum\"\r\n"]
[4.6213, "o", "        }\r\n"]
[4.621329, "o", "      + rule {\r\n"]
[4.621354, "o", "          + enabled    = true\r\n"]
[4.621383, "o", "          + expression = <<-EOT\r\n"]
[4.621423, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    label_replace(      kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"ReplicaSet\"},      \"replicaset\", \"$1\", \"owner_name\", \"(.*)\"    ) * on(replicaset, namespace) group_left(owner_name) topk by(replicaset, namespace) (      1, max by (replicaset, namespace, owner_name) (        kube_replicaset_owner{job=\"kube-state-metrics\"}      )    ),    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.621456, "o", "            EOT\r\n"]
[4.621481, "o", "          + labels     = {\r\n"]
[4.621508, "o", "              + \"workload_type\" = \"deployment\"\r\n"]
[4.621532, "o", "            }\r\n"]
[4.621561, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.621587, "o", "        }\r\n"]
[4.621611, "o", "      + rule {\r\n"]
[4.621637, "o", "          + enabled    = true\r\n"]
[4.621663, "o", "          + expression = <<-EOT\r\n"]
[4.621696, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"DaemonSet\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.621726, "o", "            EOT\r\n"]
[4.621751, "o", "          + labels     = {\r\n"]
[4.621779, "o", "              + \"workload_type\" = \"daemonset\"\r\n"]
[4.621807, "o", "            }\r\n"]
[4.621838, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.621864, "o", "        }\r\n"]
[4.621897, "o", "      + rule {\r\n"]
[4.621925, "o", "          + enabled    = true\r\n"]
[4.621957, "o", "          + expression = <<-EOT\r\n"]
[4.621992, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"StatefulSet\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.622025, "o", "            EOT\r\n"]
[4.622051, "o", "          + labels     = {\r\n"]
[4.62208, "o", "              + \"workload_type\" = \"statefulset\"\r\n"]
[4.622108, "o", "            }\r\n"]
[4.622136, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.622164, "o", "        }\r\n"]
[4.62219, "o", "      + rule {\r\n"]
[4.622217, "o", "          + enabled    = true\r\n"]
[4.622243, "o", "          + expression = <<-EOT\r\n"]
[4.622279, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"Job\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.622306, "o", "            EOT\r\n"]
[4.622339, "o", "          + labels     = {\r\n"]
[4.622368, "o", "              + \"workload_type\" = \"job\"\r\n"]
[4.622394, "o", "            }\r\n"]
[4.622421, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.622449, "o", "        }\r\n"]
[4.622477, "o", "      + rule {\r\n"]
[4.622504, "o", "          + enabled    = true\r\n"]
[4.622532, "o", "          + expression = <<-EOT\r\n"]
[4.622565, "o", "                sum(  node_memory_MemAvailable_bytes{job=\"node\"} or  (    node_memory_Buffers_bytes{job=\"node\"} +    node_memory_Cached_bytes{job=\"node\"} +    node_memory_MemFree_bytes{job=\"node\"} +    node_memory_Slab_bytes{job=\"node\"}  )) by (cluster)\r\n"]
[4.622598, "o", "            EOT\r\n"]
[4.622626, "o", "          + record     = \":node_memory_MemAvailable_bytes:sum\"\r\n"]
[4.622651, "o", "        }\r\n"]
[4.622678, "o", "      + rule {\r\n"]
[4.622702, "o", "          + enabled    = true\r\n"]
[4.622726, "o", "          + expression = <<-EOT\r\n"]
[4.622759, "o", "                sum(rate(node_cpu_seconds_total{job=\"node\",mode!=\"idle\",mode!=\"iowait\",mode!=\"steal\"}[5m])) by (cluster) /count(sum(node_cpu_seconds_total{job=\"node\"}) by (cluster, instance, cpu)) by (cluster)\r\n"]
[4.622786, "o", "            EOT\r\n"]
[4.622817, "o", "          + record     = \"cluster:node_cpu:ratio_rate5m\"\r\n"]
[4.622841, "o", "        }\r\n"]
[4.622868, "o", "    }\r\n"]
[4.622894, "o", "\r\n"]
[4.62292, "o", "  # azurerm_monitor_alert_prometheus_rule_group.node_recording_rules will be created\r\n"]
[4.622948, "o", "  + resource \"azurerm_monitor_alert_prometheus_rule_group\" \"node_recording_rules\" {\r\n"]
[4.622974, "o", "      + cluster_name        = \"aks-ep03live-test-krc\"\r\n"]
[4.623002, "o", "      + description         = \"Node Recording Rules Rule Group\"\r\n"]
[4.623029, "o", "      + id                  = (known after apply)\r\n"]
[4.623055, "o", "      + interval            = \"PT1M\"\r\n"]
[4.623081, "o", "      + location            = \"koreacentral\"\r\n"]
[4.623107, "o", "      + name                = \"NodeRecordingRulesRuleGroup-aks-ep03live-test-krc\"\r\n"]
[4.623135, "o", "      + resource_group_name = \"rg-ep03live-test-krc-aks\"\r\n"]
[4.623161, "o", "      + rule_group_enabled  = true\r\n"]
[4.623186, "o", "      + scopes              = (known after apply)\r\n"]
[4.623213, "o", "      + tags                = {\r\n"]
[4.623238, "o", "          + \"environment\"  = \"test\"\r\n"]
[4.623262, "o", "          + \"lab\"          = \"aks-terraform-guide\"\r\n"]
[4.623287, "o", "          + \"managed_by\"   = \"terraform\"\r\n"]
[4.623313, "o", "          + \"purpose\"      = \"temporary-recorded-lab\"\r\n"]
[4.62334, "o", "          + \"recording_id\" = \"ep03-20261106T030601Z\"\r\n"]
[4.623364, "o", "          + \"workload\"     = \"ep03live\"\r\n"]
[4.62339, "o", "        }\r\n"]
[4.623415, "o", "\r\n"]
[4.62344, "o", "      + rule {\r\n"]
[4.62347, "o", "          + enabled    = true\r\n"]
[4.623494, "o", "          + expression = <<-EOT\r\n"]
[4.623528, "o", "                count without (cpu, mode) (  node_cpu_seconds_total{job=\"node\",mode=\"idle\"})\r\n"]
[4.623552, "o", "            EOT\r\n"]
[4.623576, "o", "          + record     = \"instance:node_num_cpu:sum\"\r\n"]
