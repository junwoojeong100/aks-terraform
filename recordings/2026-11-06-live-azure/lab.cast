{"version": 2, "width": 140, "height": 36, "title": "AKS Terraform: actual Azure lab; private identifiers redacted", "env": {"TERM": "xterm-256color"}}
[0.000416, "o", "$ bash scripts/preflight.sh\r\n"]
[0.040682, "o", "\r\n"]
[0.040802, "o", "== 1. Tools\r\n"]
[0.321047, "o", "  \u2713 terraform 1.16.5 (min 1.16)\r\n"]
[0.918782, "o", "  \u2713 az 2.86.0 (min 2.86)\r\n"]
[1.677377, "o", "  \u2713 kubectl v1.37.1\r\n"]
[1.677755, "o", "  \u2713 kubelogin\r\n"]
[1.678098, "o", "  \u2713 jq\r\n"]
[1.6783, "o", "  \u2713 curl\r\n"]
[1.678364, "o", "\r\n"]
[1.678403, "o", "== 2. Azure sign-in\r\n"]
[2.248774, "o", "  \u2713 Subscription: <AZURE_SUBSCRIPTION> (<GUID>)\r\n"]
[2.267621, "o", "  Tenant <GUID> \u00b7 signed in as <SIGNED_IN_USER>\r\n"]
[2.267702, "o", "\r\n"]
[2.267749, "o", "== 3. Environment variables\r\n"]
[2.267793, "o", "  \u2713 ARM_SUBSCRIPTION_ID matches the current subscription\r\n"]
[2.278738, "o", "  \u2713 TF_VAR_allowed_ip_ranges = [\"<ADMIN_IP>/32\"]\r\n"]
[2.300111, "o", "  \u2713 TF_VAR_workload = ep03live\r\n"]
[2.300202, "o", "\r\n"]
[2.300256, "o", "== 4. Resource Provider registration (azurerm 5.x does not register them automatically)\r\n"]
[28.230837, "o", "  \u2713 All required Resource Providers are registered\r\n"]
[28.230932, "o", "\r\n"]
[28.230978, "o", "== 5. vCPU quota (koreacentral)\r\n"]
[29.584672, "o", "  \u2713 VM family standardDDSv5Family: 100 vCPU free\r\n"]
[29.603317, "o", "  \u2713 Regional total (Total Regional vCPUs): 100 vCPU free\r\n"]
[29.603394, "o", "\r\n"]
[29.603438, "o", "== 6. VM size (Standard_D4ds_v5 @ koreacentral)\r\n"]
[115.92943, "o", "  \u2713 Availability zones 1,2,3 are all available\r\n"]
[115.938565, "o", "  \u2713 No subscription restrictions\r\n"]
[115.938634, "o", "\r\n"]
[115.938677, "o", "== 7. Permissions (this lab creates many role assignments)\r\n"]
[121.656919, "o", "  \u2713 Has the Owner role\r\n"]
[121.657002, "o", "\r\n"]
[121.657059, "o", "Summary  passed 16 \u00b7 failed 0 \u00b7 warnings 0 \u00b7 skipped 0\r\n"]
