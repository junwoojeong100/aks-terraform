[673.618156, "o", "  + resource \"azurerm_monitor_alert_prometheus_rule_group\" \"kubernetes_recording_rules\" {\r\n"]
[673.618183, "o", "      + cluster_name        = \"aks-ep03live-test-krc\"\r\n"]
[673.61821, "o", "      + description         = \"Kubernetes Recording Rules Rule Group\"\r\n"]
[673.618238, "o", "      + id                  = (known after apply)\r\n"]
[673.618266, "o", "      + interval            = \"PT1M\"\r\n"]
[673.618293, "o", "      + location            = \"koreacentral\"\r\n"]
[673.618327, "o", "      + name                = \"KubernetesRecordingRulesRuleGroup-aks-ep03live-test-krc\"\r\n"]
[673.618355, "o", "      + resource_group_name = \"rg-ep03live-test-krc-aks\"\r\n"]
[673.618384, "o", "      + rule_group_enabled  = true\r\n"]
[673.618412, "o", "      + scopes              = (known after apply)\r\n"]
[673.618438, "o", "      + tags                = {\r\n"]
[673.618462, "o", "          + \"environment\"  = \"test\"\r\n"]
[673.618489, "o", "          + \"lab\"          = \"aks-terraform-guide\"\r\n"]
[673.618514, "o", "          + \"managed_by\"   = \"terraform\"\r\n"]
[673.61854, "o", "          + \"purpose\"      = \"temporary-recorded-lab\"\r\n"]
[673.618565, "o", "          + \"recording_id\" = \"ep03-20261106T030601Z\"\r\n"]
[673.618593, "o", "          + \"workload\"     = \"ep03live\"\r\n"]
[673.618626, "o", "        }\r\n"]
[673.618651, "o", "\r\n"]
[673.618679, "o", "      + rule {\r\n"]
[673.618708, "o", "          + enabled    = true\r\n"]
[673.618733, "o", "          + expression = <<-EOT\r\n"]
[673.618772, "o", "                sum by (cluster, namespace, pod, container) (  irate(container_cpu_usage_seconds_total{job=\"cadvisor\", image!=\"\"}[5m])) * on (cluster, namespace, pod) group_left(node) topk by (cluster, namespace, pod) (  1, max by(cluster, namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[673.618811, "o", "            EOT\r\n"]
[673.618842, "o", "          + record     = \"node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate\"\r\n"]
[673.618867, "o", "        }\r\n"]
[673.618896, "o", "      + rule {\r\n"]
[673.618923, "o", "          + enabled    = true\r\n"]
[673.618948, "o", "          + expression = <<-EOT\r\n"]
[673.618982, "o", "                container_memory_working_set_bytes{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[673.619012, "o", "            EOT\r\n"]
[673.61904, "o", "          + record     = \"node_namespace_pod_container:container_memory_working_set_bytes\"\r\n"]
[673.619067, "o", "        }\r\n"]
[673.619092, "o", "      + rule {\r\n"]
[673.619119, "o", "          + enabled    = true\r\n"]
[673.619144, "o", "          + expression = <<-EOT\r\n"]
[673.619175, "o", "                container_memory_rss{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[673.619208, "o", "            EOT\r\n"]
[673.619236, "o", "          + record     = \"node_namespace_pod_container:container_memory_rss\"\r\n"]
[673.619262, "o", "        }\r\n"]
[673.619293, "o", "      + rule {\r\n"]
[673.619326, "o", "          + enabled    = true\r\n"]
[673.619356, "o", "          + expression = <<-EOT\r\n"]
[673.619389, "o", "                container_memory_cache{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[673.619415, "o", "            EOT\r\n"]
[673.619444, "o", "          + record     = \"node_namespace_pod_container:container_memory_cache\"\r\n"]
[673.619469, "o", "        }\r\n"]
[673.619494, "o", "      + rule {\r\n"]
[673.619521, "o", "          + enabled    = true\r\n"]
[673.61955, "o", "          + expression = <<-EOT\r\n"]
[673.619581, "o", "                container_memory_swap{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[673.619607, "o", "            EOT\r\n"]
[673.619633, "o", "          + record     = \"node_namespace_pod_container:container_memory_swap\"\r\n"]
[673.61966, "o", "        }\r\n"]
[673.619686, "o", "      + rule {\r\n"]
[673.619715, "o", "          + enabled    = true\r\n"]
[673.619746, "o", "          + expression = <<-EOT\r\n"]
[673.61978, "o", "                kube_pod_container_resource_requests{resource=\"memory\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[673.61981, "o", "            EOT\r\n"]
[673.619838, "o", "          + record     = \"cluster:namespace:pod_memory:active:kube_pod_container_resource_requests\"\r\n"]
[673.619864, "o", "        }\r\n"]
[673.619888, "o", "      + rule {\r\n"]
[673.619914, "o", "          + enabled    = true\r\n"]
[673.619938, "o", "          + expression = <<-EOT\r\n"]
[673.619984, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_requests{resource=\"memory\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[673.620017, "o", "            EOT\r\n"]
[673.620049, "o", "          + record     = \"namespace_memory:kube_pod_container_resource_requests:sum\"\r\n"]
[673.620073, "o", "        }\r\n"]
[673.620102, "o", "      + rule {\r\n"]
[673.620132, "o", "          + enabled    = true\r\n"]
[673.620158, "o", "          + expression = <<-EOT\r\n"]
[673.620191, "o", "                kube_pod_container_resource_requests{resource=\"cpu\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[673.620223, "o", "            EOT\r\n"]
[673.620255, "o", "          + record     = \"cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests\"\r\n"]
[673.620282, "o", "        }\r\n"]
[673.620313, "o", "      + rule {\r\n"]
[673.620338, "o", "          + enabled    = true\r\n"]
[673.620366, "o", "          + expression = <<-EOT\r\n"]
[673.620403, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_requests{resource=\"cpu\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[673.62043, "o", "            EOT\r\n"]
[673.620462, "o", "          + record     = \"namespace_cpu:kube_pod_container_resource_requests:sum\"\r\n"]
[673.620489, "o", "        }\r\n"]
[673.620517, "o", "      + rule {\r\n"]
[673.620546, "o", "          + enabled    = true\r\n"]
[673.620573, "o", "          + expression = <<-EOT\r\n"]
[673.620612, "o", "                kube_pod_container_resource_limits{resource=\"memory\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[673.620641, "o", "            EOT\r\n"]
[673.620671, "o", "          + record     = \"cluster:namespace:pod_memory:active:kube_pod_container_resource_limits\"\r\n"]
[673.620699, "o", "        }\r\n"]
[673.620726, "o", "      + rule {\r\n"]
[673.620752, "o", "          + enabled    = true\r\n"]
[673.620778, "o", "          + expression = <<-EOT\r\n"]
[673.620817, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_limits{resource=\"memory\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[673.620845, "o", "            EOT\r\n"]
[673.620872, "o", "          + record     = \"namespace_memory:kube_pod_container_resource_limits:sum\"\r\n"]
[673.620898, "o", "        }\r\n"]
[673.620924, "o", "      + rule {\r\n"]
[673.620953, "o", "          + enabled    = true\r\n"]
[673.620978, "o", "          + expression = <<-EOT\r\n"]
[673.62101, "o", "                kube_pod_container_resource_limits{resource=\"cpu\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) ( (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1) )\r\n"]
[673.621046, "o", "            EOT\r\n"]
[673.621072, "o", "          + record     = \"cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits\"\r\n"]
[673.621102, "o", "        }\r\n"]
[673.621127, "o", "      + rule {\r\n"]
[673.621156, "o", "          + enabled    = true\r\n"]
[673.62118, "o", "          + expression = <<-EOT\r\n"]
[673.621218, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_limits{resource=\"cpu\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[673.621248, "o", "            EOT\r\n"]
[673.621274, "o", "          + record     = \"namespace_cpu:kube_pod_container_resource_limits:sum\"\r\n"]
[673.6213, "o", "        }\r\n"]
[673.621329, "o", "      + rule {\r\n"]
[673.621354, "o", "          + enabled    = true\r\n"]
[673.621383, "o", "          + expression = <<-EOT\r\n"]
[673.621423, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    label_replace(      kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"ReplicaSet\"},      \"replicaset\", \"$1\", \"owner_name\", \"(.*)\"    ) * on(replicaset, namespace) group_left(owner_name) topk by(replicaset, namespace) (      1, max by (replicaset, namespace, owner_name) (        kube_replicaset_owner{job=\"kube-state-metrics\"}      )    ),    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[673.621456, "o", "            EOT\r\n"]
[673.621481, "o", "          + labels     = {\r\n"]
[673.621508, "o", "              + \"workload_type\" = \"deployment\"\r\n"]
[673.621532, "o", "            }\r\n"]
[673.621561, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[673.621587, "o", "        }\r\n"]
[673.621611, "o", "      + rule {\r\n"]
[673.621637, "o", "          + enabled    = true\r\n"]
[673.621663, "o", "          + expression = <<-EOT\r\n"]
[673.621696, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"DaemonSet\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[673.621726, "o", "            EOT\r\n"]
[673.621751, "o", "          + labels     = {\r\n"]
[673.621779, "o", "              + \"workload_type\" = \"daemonset\"\r\n"]
[673.621807, "o", "            }\r\n"]
[673.621838, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[673.621864, "o", "        }\r\n"]
[673.621897, "o", "      + rule {\r\n"]
[673.621925, "o", "          + enabled    = true\r\n"]
[673.621957, "o", "          + expression = <<-EOT\r\n"]
[673.621992, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"StatefulSet\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[673.622025, "o", "            EOT\r\n"]
[673.622051, "o", "          + labels     = {\r\n"]
[673.62208, "o", "              + \"workload_type\" = \"statefulset\"\r\n"]
[673.622108, "o", "            }\r\n"]
[673.622136, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[673.622164, "o", "        }\r\n"]
[673.62219, "o", "      + rule {\r\n"]
[673.622217, "o", "          + enabled    = true\r\n"]
[673.622243, "o", "          + expression = <<-EOT\r\n"]
[673.622279, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"Job\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[673.622306, "o", "            EOT\r\n"]
[673.622339, "o", "          + labels     = {\r\n"]
[673.622368, "o", "              + \"workload_type\" = \"job\"\r\n"]
[673.622394, "o", "            }\r\n"]
[673.622421, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[673.622449, "o", "        }\r\n"]
[673.622477, "o", "      + rule {\r\n"]
[673.622504, "o", "          + enabled    = true\r\n"]
[673.622532, "o", "          + expression = <<-EOT\r\n"]
[673.622565, "o", "                sum(  node_memory_MemAvailable_bytes{job=\"node\"} or  (    node_memory_Buffers_bytes{job=\"node\"} +    node_memory_Cached_bytes{job=\"node\"} +    node_memory_MemFree_bytes{job=\"node\"} +    node_memory_Slab_bytes{job=\"node\"}  )) by (cluster)\r\n"]
[673.622598, "o", "            EOT\r\n"]
[673.622626, "o", "          + record     = \":node_memory_MemAvailable_bytes:sum\"\r\n"]
[673.622651, "o", "        }\r\n"]
[673.622678, "o", "      + rule {\r\n"]
[673.622702, "o", "          + enabled    = true\r\n"]
[673.622726, "o", "          + expression = <<-EOT\r\n"]
[673.622759, "o", "                sum(rate(node_cpu_seconds_total{job=\"node\",mode!=\"idle\",mode!=\"iowait\",mode!=\"steal\"}[5m])) by (cluster) /count(sum(node_cpu_seconds_total{job=\"node\"}) by (cluster, instance, cpu)) by (cluster)\r\n"]
[673.622786, "o", "            EOT\r\n"]
[673.622817, "o", "          + record     = \"cluster:node_cpu:ratio_rate5m\"\r\n"]
[673.622841, "o", "        }\r\n"]
[673.622868, "o", "    }\r\n"]
[673.622894, "o", "\r\n"]
[673.62292, "o", "  # azurerm_monitor_alert_prometheus_rule_group.node_recording_rules will be created\r\n"]
[673.622948, "o", "  + resource \"azurerm_monitor_alert_prometheus_rule_group\" \"node_recording_rules\" {\r\n"]
[673.622974, "o", "      + cluster_name        = \"aks-ep03live-test-krc\"\r\n"]
[673.623002, "o", "      + description         = \"Node Recording Rules Rule Group\"\r\n"]
[673.623029, "o", "      + id                  = (known after apply)\r\n"]
[673.623055, "o", "      + interval            = \"PT1M\"\r\n"]
[673.623081, "o", "      + location            = \"koreacentral\"\r\n"]
[673.623107, "o", "      + name                = \"NodeRecordingRulesRuleGroup-aks-ep03live-test-krc\"\r\n"]
[673.623135, "o", "      + resource_group_name = \"rg-ep03live-test-krc-aks\"\r\n"]
[673.623161, "o", "      + rule_group_enabled  = true\r\n"]
[673.623186, "o", "      + scopes              = (known after apply)\r\n"]
[673.623213, "o", "      + tags                = {\r\n"]
[673.623238, "o", "          + \"environment\"  = \"test\"\r\n"]
[673.623262, "o", "          + \"lab\"          = \"aks-terraform-guide\"\r\n"]
[673.623287, "o", "          + \"managed_by\"   = \"terraform\"\r\n"]
[673.623313, "o", "          + \"purpose\"      = \"temporary-recorded-lab\"\r\n"]
[673.62334, "o", "          + \"recording_id\" = \"ep03-20261106T030601Z\"\r\n"]
[673.623364, "o", "          + \"workload\"     = \"ep03live\"\r\n"]
[673.62339, "o", "        }\r\n"]
[673.623415, "o", "\r\n"]
[673.62344, "o", "      + rule {\r\n"]
[673.62347, "o", "          + enabled    = true\r\n"]
[673.623494, "o", "          + expression = <<-EOT\r\n"]
[673.623528, "o", "                count without (cpu, mode) (  node_cpu_seconds_total{job=\"node\",mode=\"idle\"})\r\n"]
[673.623552, "o", "            EOT\r\n"]
[673.623576, "o", "          + record     = \"instance:node_num_cpu:sum\"\r\n"]
[673.62361, "o", "        }\r\n"]
[673.623642, "o", "      + rule {\r\n"]
[673.623667, "o", "          + enabled    = true\r\n"]
[673.623694, "o", "          + expression = <<-EOT\r\n"]
[673.623723, "o", "                1 - avg without (cpu) (  sum without (mode) (rate(node_cpu_seconds_total{job=\"node\", mode=~\"idle|iowait|steal\"}[5m])))\r\n"]
[673.623748, "o", "            EOT\r\n"]
[673.623774, "o", "          + record     = \"instance:node_cpu_utilisation:rate5m\"\r\n"]
[673.623802, "o", "        }\r\n"]
[673.623826, "o", "      + rule {\r\n"]
[673.623852, "o", "          + enabled    = true\r\n"]
[673.62388, "o", "          + expression = <<-EOT\r\n"]
[673.623908, "o", "                (  node_load1{job=\"node\"}/  instance:node_num_cpu:sum{job=\"node\"})\r\n"]
[673.623937, "o", "            EOT\r\n"]
[673.623966, "o", "          + record     = \"instance:node_load1_per_cpu:ratio\"\r\n"]
[673.623993, "o", "        }\r\n"]
[673.624018, "o", "      + rule {\r\n"]
[673.624045, "o", "          + enabled    = true\r\n"]
[673.62407, "o", "          + expression = <<-EOT\r\n"]
[673.624114, "o", "                1 - (  (    node_memory_MemAvailable_bytes{job=\"node\"}    or    (      node_memory_Buffers_bytes{job=\"node\"}      +      node_memory_Cached_bytes{job=\"node\"}      +      node_memory_MemFree_bytes{job=\"node\"}      +      node_memory_Slab_bytes{job=\"node\"}    )  )/  node_memory_MemTotal_bytes{job=\"node\"})\r\n"]
[673.62415, "o", "            EOT\r\n"]
[673.624178, "o", "          + record     = \"instance:node_memory_utilisation:ratio\"\r\n"]
[673.624202, "o", "        }\r\n"]
[673.624227, "o", "      + rule {\r\n"]
[673.624254, "o", "          + enabled    = true\r\n"]
[673.624279, "o", "          + expression = <<-EOT\r\n"]
[673.624307, "o", "                rate(node_vmstat_pgmajfault{job=\"node\"}[5m])\r\n"]
[673.624333, "o", "            EOT\r\n"]
[673.624359, "o", "          + record     = \"instance:node_vmstat_pgmajfault:rate5m\"\r\n"]
[673.624384, "o", "        }\r\n"]
[673.62441, "o", "      + rule {\r\n"]
[673.624436, "o", "          + enabled    = true\r\n"]
[673.624468, "o", "          + expression = <<-EOT\r\n"]
[673.624495, "o", "                rate(node_disk_io_time_seconds_total{job=\"node\", device!=\"\"}[5m])\r\n"]
[673.624522, "o", "            EOT\r\n"]
[673.624553, "o", "          + record     = \"instance_device:node_disk_io_time_seconds:rate5m\"\r\n"]
[673.624593, "o", "        }\r\n"]
[673.624619, "o", "      + rule {\r\n"]
[673.624646, "o", "          + enabled    = true\r\n"]
[673.624675, "o", "          + expression = <<-EOT\r\n"]
[673.624704, "o", "                rate(node_disk_io_time_weighted_seconds_total{job=\"node\", device!=\"\"}[5m])\r\n"]
[673.624731, "o", "            EOT\r\n"]
[673.624758, "o", "          + record     = \"instance_device:node_disk_io_time_weighted_seconds:rate5m\"\r\n"]
[673.624785, "o", "        }\r\n"]
[673.624811, "o", "      + rule {\r\n"]
[673.624837, "o", "          + enabled    = true\r\n"]
[673.624863, "o", "          + expression = <<-EOT\r\n"]
[673.624891, "o", "                sum without (device) (  rate(node_network_receive_bytes_total{job=\"node\", device!=\"lo\"}[5m]))\r\n"]
[673.624918, "o", "            EOT\r\n"]
[673.624946, "o", "          + record     = \"instance:node_network_receive_bytes_excluding_lo:rate5m\"\r\n"]
[673.624978, "o", "        }\r\n"]
[673.625004, "o", "      + rule {\r\n"]
[673.62503, "o", "          + enabled    = true\r\n"]
[673.625055, "o", "          + expression = <<-EOT\r\n"]
[673.625084, "o", "                sum without (device) (  rate(node_network_transmit_bytes_total{job=\"node\", device!=\"lo\"}[5m]))\r\n"]
[673.62511, "o", "            EOT\r\n"]
[673.625137, "o", "          + record     = \"instance:node_network_transmit_bytes_excluding_lo:rate5m\"\r\n"]
[673.625165, "o", "        }\r\n"]
[673.625191, "o", "      + rule {\r\n"]
[673.625217, "o", "          + enabled    = true\r\n"]
[673.625243, "o", "          + expression = <<-EOT\r\n"]
[673.625271, "o", "                sum without (device) (  rate(node_network_receive_drop_total{job=\"node\", device!=\"lo\"}[5m]))\r\n"]
[673.6253, "o", "            EOT\r\n"]
[673.625327, "o", "          + record     = \"instance:node_network_receive_drop_excluding_lo:rate5m\"\r\n"]
[673.625352, "o", "        }\r\n"]
[673.625377, "o", "      + rule {\r\n"]
[673.625404, "o", "          + enabled    = true\r\n"]
[673.62543, "o", "          + expression = <<-EOT\r\n"]
[673.625462, "o", "                sum without (device) (  rate(node_network_transmit_drop_total{job=\"node\", device!=\"lo\"}[5m]))\r\n"]
[673.625491, "o", "            EOT\r\n"]
[673.625518, "o", "          + record     = \"instance:node_network_transmit_drop_excluding_lo:rate5m\"\r\n"]
[673.62555, "o", "        }\r\n"]
[673.625575, "o", "    }\r\n"]
