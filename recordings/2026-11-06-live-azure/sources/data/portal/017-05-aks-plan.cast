[4.73292, "o", "                rate(node_disk_io_time_weighted_seconds_total{job=\"node\", device!=\"\"}[5m])\r\n"]
[4.732946, "o", "            EOT\r\n"]
[4.732978, "o", "          + record     = \"instance_device:node_disk_io_time_weighted_seconds:rate5m\"\r\n"]
