[4.732683, "o", "          + expression = <<-EOT\r\n"]
[4.732715, "o", "                rate(node_disk_io_time_seconds_total{job=\"node\", device!=\"\"}[5m])\r\n"]
[4.732742, "o", "            EOT\r\n"]
[4.732774, "o", "          + record     = \"instance_device:node_disk_io_time_seconds:rate5m\"\r\n"]
