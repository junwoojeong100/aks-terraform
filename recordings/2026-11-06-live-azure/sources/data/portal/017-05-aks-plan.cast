[4.726407, "o", "\r\n"]
[4.726436, "o", "      + rule {\r\n"]
[4.726469, "o", "          + enabled    = true\r\n"]
[4.726497, "o", "          + expression = <<-EOT\r\n"]
[4.72654, "o", "                sum by (cluster, namespace, pod, container) (  irate(container_cpu_usage_seconds_total{job=\"cadvisor\", image!=\"\"}[5m])) * on (cluster, namespace, pod) group_left(node) topk by (cluster, namespace, pod) (  1, max by(cluster, namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.726581, "o", "            EOT\r\n"]
[4.726616, "o", "          + record     = \"node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate\"\r\n"]
[4.726642, "o", "        }\r\n"]
[4.726674, "o", "      + rule {\r\n"]
[4.7267, "o", "          + enabled    = true\r\n"]
[4.726728, "o", "          + expression = <<-EOT\r\n"]
[4.726761, "o", "                container_memory_working_set_bytes{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.726792, "o", "            EOT\r\n"]
[4.726822, "o", "          + record     = \"node_namespace_pod_container:container_memory_working_set_bytes\"\r\n"]
[4.726849, "o", "        }\r\n"]
[4.726875, "o", "      + rule {\r\n"]
[4.726908, "o", "          + enabled    = true\r\n"]
[4.726935, "o", "          + expression = <<-EOT\r\n"]
[4.726972, "o", "                container_memory_rss{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.727001, "o", "            EOT\r\n"]
[4.727031, "o", "          + record     = \"node_namespace_pod_container:container_memory_rss\"\r\n"]
[4.727061, "o", "        }\r\n"]
[4.727088, "o", "      + rule {\r\n"]
[4.727119, "o", "          + enabled    = true\r\n"]
[4.727148, "o", "          + expression = <<-EOT\r\n"]
[4.727183, "o", "                container_memory_cache{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.727213, "o", "            EOT\r\n"]
[4.727242, "o", "          + record     = \"node_namespace_pod_container:container_memory_cache\"\r\n"]
[4.727272, "o", "        }\r\n"]
[4.727298, "o", "      + rule {\r\n"]
[4.727324, "o", "          + enabled    = true\r\n"]
[4.727353, "o", "          + expression = <<-EOT\r\n"]
[4.72739, "o", "                container_memory_swap{job=\"cadvisor\", image!=\"\"}* on (namespace, pod) group_left(node) topk by(namespace, pod) (1,  max by(namespace, pod, node) (kube_pod_info{node!=\"\"}))\r\n"]
[4.727419, "o", "            EOT\r\n"]
[4.727447, "o", "          + record     = \"node_namespace_pod_container:container_memory_swap\"\r\n"]
[4.727474, "o", "        }\r\n"]
[4.727502, "o", "      + rule {\r\n"]
[4.727532, "o", "          + enabled    = true\r\n"]
[4.727558, "o", "          + expression = <<-EOT\r\n"]
[4.727592, "o", "                kube_pod_container_resource_requests{resource=\"memory\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[4.727628, "o", "            EOT\r\n"]
[4.727659, "o", "          + record     = \"cluster:namespace:pod_memory:active:kube_pod_container_resource_requests\"\r\n"]
[4.72769, "o", "        }\r\n"]
[4.727717, "o", "      + rule {\r\n"]
[4.727746, "o", "          + enabled    = true\r\n"]
[4.727773, "o", "          + expression = <<-EOT\r\n"]
[4.72782, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_requests{resource=\"memory\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.727859, "o", "            EOT\r\n"]
[4.727887, "o", "          + record     = \"namespace_memory:kube_pod_container_resource_requests:sum\"\r\n"]
[4.727915, "o", "        }\r\n"]
[4.727951, "o", "      + rule {\r\n"]
[4.727979, "o", "          + enabled    = true\r\n"]
[4.728011, "o", "          + expression = <<-EOT\r\n"]
[4.728045, "o", "                kube_pod_container_resource_requests{resource=\"cpu\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[4.728076, "o", "            EOT\r\n"]
[4.728108, "o", "          + record     = \"cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests\"\r\n"]
[4.728135, "o", "        }\r\n"]
[4.728165, "o", "      + rule {\r\n"]
[4.728198, "o", "          + enabled    = true\r\n"]
[4.728226, "o", "          + expression = <<-EOT\r\n"]
[4.728267, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_requests{resource=\"cpu\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.728296, "o", "            EOT\r\n"]
[4.728325, "o", "          + record     = \"namespace_cpu:kube_pod_container_resource_requests:sum\"\r\n"]
[4.728352, "o", "        }\r\n"]
[4.728376, "o", "      + rule {\r\n"]
[4.728404, "o", "          + enabled    = true\r\n"]
[4.728431, "o", "          + expression = <<-EOT\r\n"]
[4.728464, "o", "                kube_pod_container_resource_limits{resource=\"memory\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) (  (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))\r\n"]
[4.728492, "o", "            EOT\r\n"]
[4.72852, "o", "          + record     = \"cluster:namespace:pod_memory:active:kube_pod_container_resource_limits\"\r\n"]
[4.728545, "o", "        }\r\n"]
[4.728578, "o", "      + rule {\r\n"]
[4.728606, "o", "          + enabled    = true\r\n"]
[4.728633, "o", "          + expression = <<-EOT\r\n"]
[4.728673, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_limits{resource=\"memory\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.728706, "o", "            EOT\r\n"]
[4.728734, "o", "          + record     = \"namespace_memory:kube_pod_container_resource_limits:sum\"\r\n"]
[4.728761, "o", "        }\r\n"]
[4.72879, "o", "      + rule {\r\n"]
[4.728817, "o", "          + enabled    = true\r\n"]
[4.728843, "o", "          + expression = <<-EOT\r\n"]
[4.728877, "o", "                kube_pod_container_resource_limits{resource=\"cpu\",job=\"kube-state-metrics\"}  * on (namespace, pod, cluster)group_left() max by (namespace, pod, cluster) ( (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1) )\r\n"]
[4.728907, "o", "            EOT\r\n"]
[4.728934, "o", "          + record     = \"cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits\"\r\n"]
[4.728967, "o", "        }\r\n"]
[4.728992, "o", "      + rule {\r\n"]
[4.729021, "o", "          + enabled    = true\r\n"]
[4.72905, "o", "          + expression = <<-EOT\r\n"]
[4.729094, "o", "                sum by (namespace, cluster) (    sum by (namespace, pod, cluster) (        max by (namespace, pod, container, cluster) (          kube_pod_container_resource_limits{resource=\"cpu\",job=\"kube-state-metrics\"}        ) * on(namespace, pod, cluster) group_left() max by (namespace, pod, cluster) (          kube_pod_status_phase{phase=~\"Pending|Running\"} == 1        )    ))\r\n"]
[4.729129, "o", "            EOT\r\n"]
[4.72916, "o", "          + record     = \"namespace_cpu:kube_pod_container_resource_limits:sum\"\r\n"]
[4.729187, "o", "        }\r\n"]
[4.729212, "o", "      + rule {\r\n"]
[4.729239, "o", "          + enabled    = true\r\n"]
[4.729265, "o", "          + expression = <<-EOT\r\n"]
[4.729308, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    label_replace(      kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"ReplicaSet\"},      \"replicaset\", \"$1\", \"owner_name\", \"(.*)\"    ) * on(replicaset, namespace) group_left(owner_name) topk by(replicaset, namespace) (      1, max by (replicaset, namespace, owner_name) (        kube_replicaset_owner{job=\"kube-state-metrics\"}      )    ),    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.729341, "o", "            EOT\r\n"]
[4.729368, "o", "          + labels     = {\r\n"]
[4.729396, "o", "              + \"workload_type\" = \"deployment\"\r\n"]
[4.729423, "o", "            }\r\n"]
[4.729451, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.729477, "o", "        }\r\n"]
[4.72951, "o", "      + rule {\r\n"]
[4.729538, "o", "          + enabled    = true\r\n"]
[4.729564, "o", "          + expression = <<-EOT\r\n"]
[4.729606, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"DaemonSet\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.729642, "o", "            EOT\r\n"]
[4.729669, "o", "          + labels     = {\r\n"]
[4.7297, "o", "              + \"workload_type\" = \"daemonset\"\r\n"]
[4.729729, "o", "            }\r\n"]
[4.729757, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.729783, "o", "        }\r\n"]
[4.729813, "o", "      + rule {\r\n"]
[4.729838, "o", "          + enabled    = true\r\n"]
[4.729866, "o", "          + expression = <<-EOT\r\n"]
[4.729898, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"StatefulSet\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.729927, "o", "            EOT\r\n"]
[4.729952, "o", "          + labels     = {\r\n"]
[4.729979, "o", "              + \"workload_type\" = \"statefulset\"\r\n"]
[4.730012, "o", "            }\r\n"]
[4.730039, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.730065, "o", "        }\r\n"]
[4.73009, "o", "      + rule {\r\n"]
[4.730117, "o", "          + enabled    = true\r\n"]
[4.730148, "o", "          + expression = <<-EOT\r\n"]
[4.73018, "o", "                max by (cluster, namespace, workload, pod) (  label_replace(    kube_pod_owner{job=\"kube-state-metrics\", owner_kind=\"Job\"},    \"workload\", \"$1\", \"owner_name\", \"(.*)\"  ))\r\n"]
[4.730211, "o", "            EOT\r\n"]
[4.730237, "o", "          + labels     = {\r\n"]
[4.730269, "o", "              + \"workload_type\" = \"job\"\r\n"]
[4.730296, "o", "            }\r\n"]
[4.730324, "o", "          + record     = \"namespace_workload_pod:kube_pod_owner:relabel\"\r\n"]
[4.73035, "o", "        }\r\n"]
[4.730378, "o", "      + rule {\r\n"]
[4.730409, "o", "          + enabled    = true\r\n"]
[4.730439, "o", "          + expression = <<-EOT\r\n"]
[4.730478, "o", "                sum(  node_memory_MemAvailable_bytes{job=\"node\"} or  (    node_memory_Buffers_bytes{job=\"node\"} +    node_memory_Cached_bytes{job=\"node\"} +    node_memory_MemFree_bytes{job=\"node\"} +    node_memory_Slab_bytes{job=\"node\"}  )) by (cluster)\r\n"]
[4.730515, "o", "            EOT\r\n"]
[4.730543, "o", "          + record     = \":node_memory_MemAvailable_bytes:sum\"\r\n"]
[4.730572, "o", "        }\r\n"]
[4.730601, "o", "      + rule {\r\n"]
[4.730627, "o", "          + enabled    = true\r\n"]
[4.730653, "o", "          + expression = <<-EOT\r\n"]
[4.730688, "o", "                sum(rate(node_cpu_seconds_total{job=\"node\",mode!=\"idle\",mode!=\"iowait\",mode!=\"steal\"}[5m])) by (cluster) /count(sum(node_cpu_seconds_total{job=\"node\"}) by (cluster, instance, cpu)) by (cluster)\r\n"]
[4.730717, "o", "            EOT\r\n"]
[4.730747, "o", "          + record     = \"cluster:node_cpu:ratio_rate5m\"\r\n"]
[4.730776, "o", "        }\r\n"]
[4.730801, "o", "    }\r\n"]
[4.73083, "o", "\r\n"]
[4.730919, "o", "  # azurerm_monitor_alert_prometheus_rule_group.node_recording_rules will be created\r\n"]
[4.730984, "o", "  + resource \"azurerm_monitor_alert_prometheus_rule_group\" \"node_recording_rules\" {\r\n"]
