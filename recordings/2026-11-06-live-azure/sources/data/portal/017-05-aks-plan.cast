[4.731577, "o", "      + rule {\r\n"]
[4.731612, "o", "          + enabled    = true\r\n"]
[4.731642, "o", "          + expression = <<-EOT\r\n"]
[4.731678, "o", "                count without (cpu, mode) (  node_cpu_seconds_total{job=\"node\",mode=\"idle\"})\r\n"]
[4.731706, "o", "            EOT\r\n"]
[4.731735, "o", "          + record     = \"instance:node_num_cpu:sum\"\r\n"]
[4.731765, "o", "        }\r\n"]
[4.731793, "o", "      + rule {\r\n"]
[4.73182, "o", "          + enabled    = true\r\n"]
[4.731853, "o", "          + expression = <<-EOT\r\n"]
[4.731886, "o", "                1 - avg without (cpu) (  sum without (mode) (rate(node_cpu_seconds_total{job=\"node\", mode=~\"idle|iowait|steal\"}[5m])))\r\n"]
[4.731913, "o", "            EOT\r\n"]
[4.731941, "o", "          + record     = \"instance:node_cpu_utilisation:rate5m\"\r\n"]
[4.731972, "o", "        }\r\n"]
[4.732001, "o", "      + rule {\r\n"]
[4.732028, "o", "          + enabled    = true\r\n"]
[4.732058, "o", "          + expression = <<-EOT\r\n"]
[4.732089, "o", "                (  node_load1{job=\"node\"}/  instance:node_num_cpu:sum{job=\"node\"})\r\n"]
[4.73212, "o", "            EOT\r\n"]
[4.732148, "o", "          + record     = \"instance:node_load1_per_cpu:ratio\"\r\n"]
[4.732174, "o", "        }\r\n"]
[4.732202, "o", "      + rule {\r\n"]
[4.732228, "o", "          + enabled    = true\r\n"]
[4.732255, "o", "          + expression = <<-EOT\r\n"]
[4.732301, "o", "                1 - (  (    node_memory_MemAvailable_bytes{job=\"node\"}    or    (      node_memory_Buffers_bytes{job=\"node\"}      +      node_memory_Cached_bytes{job=\"node\"}      +      node_memory_MemFree_bytes{job=\"node\"}      +      node_memory_Slab_bytes{job=\"node\"}    )  )/  node_memory_MemTotal_bytes{job=\"node\"})\r\n"]
[4.732346, "o", "            EOT\r\n"]
[4.732376, "o", "          + record     = \"instance:node_memory_utilisation:ratio\"\r\n"]
[4.732405, "o", "        }\r\n"]
[4.732431, "o", "      + rule {\r\n"]
[4.732459, "o", "          + enabled    = true\r\n"]
[4.732487, "o", "          + expression = <<-EOT\r\n"]
[4.732515, "o", "                rate(node_vmstat_pgmajfault{job=\"node\"}[5m])\r\n"]
[4.732543, "o", "            EOT\r\n"]
[4.732575, "o", "          + record     = \"instance:node_vmstat_pgmajfault:rate5m\"\r\n"]
[4.732601, "o", "        }\r\n"]
